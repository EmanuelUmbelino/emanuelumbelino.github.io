---
import '@/styles/global.css';
import { htmlLang, languages, ogLocale, type Lang } from '@/i18n/ui';
import { homePath, useTranslations } from '@/i18n/utils';
import { education, experience, profile, spokenLanguages } from '@/data/profile';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Emit hreflang alternates (only for pages that exist in every language). */
  alternates?: boolean;
  noindex?: boolean;
  /** Send Portuguese-speaking visitors to /pt/ unless they picked a language before. */
  detectLanguage?: boolean;
}

const {
  lang,
  title,
  description,
  alternates = true,
  noindex = false,
  detectLanguage = false,
} = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og-${lang}.png`, Astro.site);
const otherLangs = (Object.keys(languages) as Lang[]).filter((l) => l !== lang);

// Linked graph so search engines read the home pages as a ProfilePage about one Person.
const siteUrl = new URL('/', Astro.site).href;
const pageUrl = new URL(homePath(lang), Astro.site).href;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: profile.name,
      inLanguage: Object.values(htmlLang),
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: htmlLang[lang],
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      givenName: profile.firstName,
      familyName: profile.lastName,
      jobTitle: profile.headline[lang],
      description: profile.intro[lang],
      url: pageUrl,
      image: new URL('/og-avatar.png', Astro.site).href,
      email: profile.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Rio de Janeiro',
        addressCountry: 'BR',
      },
      worksFor: experience
        .filter((job) => job.end === null)
        .map((job) => ({ '@type': 'Organization', name: job.company })),
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Pontifícia Universidade Católica do Rio de Janeiro',
          alternateName: 'PUC-Rio',
        },
        ...education
          .filter((e) => e.school !== 'PUC-Rio')
          .map((e) => ({ '@type': 'EducationalOrganization', name: e.school })),
      ],
      knowsLanguage: spokenLanguages.map((l) => l.name.en),
      knowsAbout: [
        'Software Engineering',
        'Full-Stack Development',
        'Front-End Development',
        'AI Agents',
        'Large Language Models',
        'LLM Automation',
        'Spec-Driven Development',
        'UX Design',
        'TypeScript',
        'Angular',
        'React',
        'Node.js',
      ],
      sameAs: [profile.social.github, profile.social.linkedin],
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang[lang]} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Search Console ownership; removing it unverifies the property. -->
    <meta name="google-site-verification" content="aW4SQ90h61S2cZMKw__2PU0R0E7PkfrucIeohApvTmQ" />
    <meta
      name="robots"
      content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    {alternates &&
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={htmlLang[l]} href={new URL(homePath(l), Astro.site)} />
      ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#020a1f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f9ff" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={t('meta.imageAlt')} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates &&
      otherLangs.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="profile:first_name" content={profile.firstName} />
    <meta property="profile:last_name" content={profile.lastName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('meta.imageAlt')} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {detectLanguage && <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('lang');
          const browser = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
          if (saved === 'pt' || (!saved && browser.startsWith('pt'))) {
            location.replace('/pt/' + location.hash);
          }
        } catch {}
      })();
    </script>}
    <!-- Apply theme before paint to avoid a flash. Dark is the default. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') ?? 'dark';
        } catch {}
        root.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <slot />
  </body>
</html>
