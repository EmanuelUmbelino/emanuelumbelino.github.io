---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import { useTranslations } from '@/i18n/utils';

// GitHub Pages serves a single 404 for every language, so show both.
const pt = useTranslations('pt');
const en = useTranslations('en');
---

<Base lang="pt" title={`404 — ${pt('notFound.title')}`} alternates={false} noindex>
  <Header lang="pt" absoluteLinks />
  <main
    id="main"
    class="relative isolate grid min-h-dvh place-items-center overflow-hidden px-4 pt-16"
  >
    <div class="grid-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="text-center">
      <p class="text-gradient font-mono text-8xl font-extrabold tracking-tighter sm:text-9xl">
        404
      </p>
      <h1 class="mt-6 text-2xl font-bold tracking-tight sm:text-3xl">{pt('notFound.title')}</h1>
      <p class="mt-3 text-muted">{pt('notFound.text')}</p>
      <p class="mt-1 text-sm text-muted" lang="en">
        {en('notFound.text')}
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">
          {pt('notFound.back')}
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="/en/" class="btn-ghost" lang="en">
          {en('notFound.back')}
        </a>
      </div>
    </div>
  </main>
  <Footer lang="pt" />
</Base>

<script>
  import '@/scripts/main';
</script>
