---
import Icon from './Icon.astro';
import { profile } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10">
  <div class="container-page flex flex-col items-center justify-between gap-4 text-sm text-muted sm:flex-row">
    <p>{`© ${year} ${profile.name}. ${t('footer.built')}`}</p>
    <div class="flex items-center gap-2">
      <a
        href={profile.repo}
        target="_blank"
        rel="noopener"
        class="rounded-lg px-2 py-1 font-mono text-xs transition-colors hover:text-fg"
      >
        {t('footer.source')}
      </a>
      <a
        href={profile.social.linkedin}
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        class="rounded-lg p-2 transition-colors hover:text-fg"
      >
        <Icon name="linkedin" size={16} />
      </a>
      <a
        href={profile.social.github}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="rounded-lg p-2 transition-colors hover:text-fg"
      >
        <Icon name="github" size={16} />
      </a>
    </div>
  </div>
</footer>
