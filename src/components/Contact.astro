---
import Icon from './Icon.astro';
import { profile } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="py-24 sm:py-32" aria-labelledby="contact-title">
  <div class="container-page">
    <div
      class="relative isolate overflow-hidden rounded-3xl border border-brand-400/20 bg-brand-950 px-6 py-16 text-center text-white sm:px-16 sm:py-20"
      data-reveal
    >
      <div
        class="grid-bg absolute inset-0 -z-10 opacity-60 [--grid:rgb(142_172_255/0.08)]"
        aria-hidden="true"
      ></div>
      <div
        class="absolute -top-40 left-1/2 -z-10 size-[40rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgb(51_88_245/0.45),transparent_65%)]"
        aria-hidden="true"
      ></div>

      <p class="font-mono text-xs tracking-[0.2em] text-cyan-300 uppercase">
        <span class="text-brand-300">[</span> 07 <span class="text-brand-300">]</span>
        <span class="ml-1">{t('contact.label')}</span>
      </p>
      <h2
        id="contact-title"
        class="mx-auto mt-4 max-w-2xl text-3xl font-bold tracking-tight text-balance sm:text-5xl"
      >
        {t('contact.title')}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-brand-100/80">{t('contact.text')}</p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={`mailto:${profile.email}`}
          class="btn bg-white text-brand-900 shadow-xl shadow-black/20 hover:-translate-y-0.5 hover:bg-brand-50"
        >
          <Icon name="mail" size={18} />
          {t('contact.email')}
        </a>
        <button
          type="button"
          data-copy={profile.email}
          data-copied-label={t('contact.copied')}
          class="btn border border-white/20 bg-white/5 font-mono text-white hover:-translate-y-0.5 hover:bg-white/10"
        >
          <Icon name="copy" size={16} />
          <span data-copy-label>{profile.email}</span>
          <span class="sr-only">— {t('contact.copy')}</span>
        </button>
      </div>

      <ul class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <li>
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener"
            class="btn border border-white/15 px-4 py-2 text-brand-100 hover:border-white/40 hover:text-white"
          >
            <Icon name="linkedin" size={16} /> LinkedIn
          </a>
        </li>
        <li>
          <a
            href={profile.social.github}
            target="_blank"
            rel="noopener"
            class="btn border border-white/15 px-4 py-2 text-brand-100 hover:border-white/40 hover:text-white"
          >
            <Icon name="github" size={16} /> GitHub
          </a>
        </li>
        <li>
          <a
            href={profile.cv.pt}
            download
            hreflang="pt-BR"
            class="btn border border-white/15 px-4 py-2 text-brand-100 hover:border-white/40 hover:text-white"
          >
            <Icon name="download" size={16} />
            {t('contact.cv')} PT
          </a>
        </li>
        <li>
          <a
            href={profile.cv.en}
            download
            hreflang="en"
            class="btn border border-white/15 px-4 py-2 text-brand-100 hover:border-white/40 hover:text-white"
          >
            <Icon name="download" size={16} />
            {t('contact.cv')} EN
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
