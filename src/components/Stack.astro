---
import SectionHeading from './SectionHeading.astro';
import { marquee, skills } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="stack" class="py-24 sm:py-32" aria-labelledby="stack-title">
  <div class="container-page">
    <SectionHeading id="stack-title" index="03" label={t('stack.label')} title={t('stack.title')} />
  </div>

  <!-- Infinite marquee (decorative duplicate of the list below) -->
  <div
    class="group relative mb-14 flex overflow-hidden border-y border-line bg-surface/40 py-5 [mask-image:linear-gradient(90deg,transparent,black_10%,black_90%,transparent)]"
    aria-hidden="true"
  >
    <div class="flex w-max shrink-0 animate-marquee gap-10 pr-10 group-hover:[animation-play-state:paused]">
      {[...marquee, ...marquee].map((m) => (
        <span class="font-mono text-lg font-semibold whitespace-nowrap text-fg/60">
          <span class="mr-3 text-accent">◆</span>
          {m}
        </span>
      ))}
    </div>
  </div>

  <div class="container-page">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((s) => (
        <div class="card p-6" data-reveal>
          <h3 class="font-mono text-xs tracking-[0.15em] text-accent uppercase">{s.group[lang]}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {s.items.map((i) => (
              <li class="rounded-lg border border-line bg-surface-2/70 px-3 py-1.5 text-sm font-medium">
                {i}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
