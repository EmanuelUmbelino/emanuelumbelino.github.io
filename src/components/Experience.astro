---
import SectionHeading from './SectionHeading.astro';
import { experience } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="bg-surface/30 py-24 sm:py-32" aria-labelledby="experience-title">
  <div class="container-page">
    <SectionHeading
      id="experience-title"
      index="04"
      label={t('experience.label')}
      title={t('experience.title')}
    />

    <ol class="relative space-y-8 border-l border-line pl-6 sm:pl-10">
      {experience.map((job) => {
        const current = job.end === null;
        return (
          <li class="relative" data-reveal>
            <span
              class:list={[
                'absolute top-7 -left-[31px] size-3.5 rounded-full border-2 border-bg sm:-left-[47px]',
                current ? 'animate-pulse-ring bg-accent' : 'bg-brand-500',
              ]}
              aria-hidden="true"
            />
            <article class="card p-6 transition-colors hover:border-brand-400/40 sm:p-8">
              <header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <h3 class="text-xl font-bold tracking-tight">
                    {job.company}
                    <span class="ml-1 text-sm font-normal text-muted">· {job.context[lang]}</span>
                  </h3>
                  <p class="mt-1 font-medium text-link">{job.role[lang]}</p>
                </div>
                <div class="flex shrink-0 flex-wrap items-center gap-2 sm:flex-col sm:items-end">
                  <span class:list={['chip', current && 'border-accent/40 text-fg']}>
                    {job.start[lang]} — {job.end ? job.end[lang] : t('experience.present')}
                  </span>
                  <span class="font-mono text-xs text-muted">{job.mode[lang]}</span>
                </div>
              </header>
              <ul class="mt-5 space-y-2.5 text-muted">
                {job.bullets[lang].map((b) => (
                  <li class="flex gap-3 leading-relaxed text-pretty">
                    <span
                      class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent"
                      aria-hidden="true"
                    />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <ul class="mt-6 flex flex-wrap gap-2">
                {job.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>
