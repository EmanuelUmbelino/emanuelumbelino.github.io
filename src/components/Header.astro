---
import Icon from './Icon.astro';
import type { Lang, UIKey } from '@/i18n/ui';
import { homePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  /** Prefix nav anchors with the home path (for pages other than home). */
  absoluteLinks?: boolean;
}

const { lang, absoluteLinks = false } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';

const links: { id: string; key: UIKey }[] = [
  { id: 'about', key: 'nav.about' },
  { id: 'ai', key: 'nav.ai' },
  { id: 'stack', key: 'nav.stack' },
  { id: 'experience', key: 'nav.experience' },
  { id: 'projects', key: 'nav.projects' },
  { id: 'contact', key: 'nav.contact' },
];
const href = (id: string) => (absoluteLinks ? `${home}#${id}` : `#${id}`);
---

<a
  href="#main"
  class="sr-only z-[60] rounded-lg bg-primary px-4 py-2 text-primary-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
  {t('nav.skip')}
</a>

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled=true]:border-line data-[scrolled=true]:bg-bg/75 data-[scrolled=true]:backdrop-blur-lg"
>
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a
      href={home}
      class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight"
    >
      <span
        class="grid size-8 place-items-center rounded-lg bg-brand-800 text-xs text-white shadow-md shadow-brand-800/30 transition-transform group-hover:-rotate-6"
        aria-hidden="true"
      >
        EU
      </span>
      <span>
        emanuel<span class="text-accent">.</span>umbelino
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={href(l.id)}
            data-nav-link={l.id}
            class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-fg aria-[current=true]:text-fg"
          >
            {t(l.key)}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <a
        href={homePath(otherLang)}
        hreflang={otherLang}
        data-lang-switch={otherLang}
        lang={otherLang}
        aria-label={t('lang.switch')}
        title={t('lang.switch')}
        class="rounded-lg px-2.5 py-2 font-mono text-xs font-semibold text-muted uppercase transition-colors hover:bg-surface-2 hover:text-fg"
      >
        {otherLang}
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-fg"
      >
        <Icon name="sun" size={18} class="hidden dark:block" />
        <Icon name="moon" size={18} class="block dark:hidden" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.menu')}
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
        class="group grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-fg lg:hidden"
      >
        <Icon name="menu" size={20} class="group-aria-expanded:hidden" />
        <Icon name="x" size={20} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu
    hidden
    class="border-t border-line bg-bg/95 backdrop-blur-lg lg:hidden"
  >
    <ul class="container-page flex flex-col py-3">
      {links.map((l) => (
        <li>
          <a
            href={href(l.id)}
            class="block rounded-lg px-3 py-3 text-base text-muted transition-colors hover:bg-surface-2 hover:text-fg"
          >
            {t(l.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
