---
interface Props {
  index: string;
  label: string;
  title: string;
  subtitle?: string;
  id?: string;
}

const { index, label, title, subtitle, id } = Astro.props;
---

<div class="mb-12 max-w-2xl" data-reveal>
  <p class="mb-3 font-mono text-xs tracking-[0.2em] text-accent uppercase">
    <span class="text-muted">[</span>
    {index}
    <span class="text-muted">]</span>
    <span class="ml-1">{label}</span>
  </p>
  <h2 id={id} class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
    {title}
  </h2>
  {subtitle && <p class="mt-4 text-lg text-pretty text-muted">{subtitle}</p>}
</div>
