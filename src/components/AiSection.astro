---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { aiHighlights } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="ai" class="relative isolate py-24 sm:py-32" aria-labelledby="ai-title">
  <div
    class="absolute inset-x-0 top-1/3 -z-10 h-96 bg-[radial-gradient(ellipse_at_center,var(--glow),transparent_65%)]"
    aria-hidden="true"
  ></div>
  <div class="container-page">
    <SectionHeading
      id="ai-title"
      index="02"
      label={t('ai.label')}
      title={t('ai.title')}
      subtitle={t('ai.subtitle')}
    />

    <ul class="grid gap-5 md:grid-cols-2">
      {aiHighlights.map((item) => (
        <li
          class="card group relative overflow-hidden p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-400/40"
          data-reveal
        >
          <div
            class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-400 to-transparent opacity-0 transition-opacity group-hover:opacity-100"
            aria-hidden="true"
          />
          <div class="mb-5 grid size-11 place-items-center rounded-xl bg-brand-800 text-white shadow-lg shadow-brand-800/30">
            <Icon name={item.icon} size={22} />
          </div>
          <h3 class="text-xl font-semibold tracking-tight">{item.title[lang]}</h3>
          <p class="mt-3 leading-relaxed text-pretty text-muted">{item.text[lang]}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
